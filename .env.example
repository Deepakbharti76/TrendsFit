# Copy to .env (never commit .env). All values below are PLACEHOLDERS.
# Database
DB_URL=jdbc:mysql://localhost:3306/trendsfit?useSSL=false&serverTimezone=UTC
DB_USERNAME=trendsfit
DB_PASSWORD=change-me
# Auth (REQUIRED, >= 32 random characters: e.g. `openssl rand -base64 48`)
JWT_SECRET=
JWT_TTL_MINUTES=720
# First Super Admin (created once if no admin exists; password >= 10 chars, upper+lower+digit)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# URLs
PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Razorpay (test keys first)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Shiprocket (API user)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_POSTCODE=
# Email (optional; disabled unless MAIL_ENABLED=true)
MAIL_ENABLED=false
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
# Business
BUSINESS_NAME=TrendsFit
BUSINESS_EMAIL=
BUSINESS_WHATSAPP=
BUSINESS_ADDRESS=
SHIPPING_FLAT_RATE=
SHIPPING_FREE_ABOVE=
COD_ENABLED=true
EXCHANGE_WINDOW_DAYS=7
